    <style>
        :root {
            --bg-color: #0d1117;
            --card-bg: #161b22;
            --accent-blue: #58a6ff;
            --accent-green: #3fb950;
            --accent-purple: #bc8cff;
            --accent-orange: #d29922;
            --text-main: #c9d1d9;
            --text-muted: #8b949e;
            --border-color: #30363d;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
        }

        body {
            background-color: var(--bg-color);
            color: var(--text-main);
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            min-height: 100vh;
            overflow-x: hidden;
            padding: 20px;
        }

        .slide-container {
            width: 100%;
            max-width: 1000px;
            height: 620px;
            background-color: var(--card-bg);
            border: 1px solid var(--border-color);
            border-radius: 12px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.5);
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            padding: 40px;
            position: relative;
            overflow: hidden;
        }

        .slide {
            display: none;
            height: 100%;
            flex-direction: column;
            animation: fadeIn 0.3s ease-in-out;
        }

        .slide.active {
            display: flex;
        }

        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(5px); }
            to { opacity: 1; transform: translateY(0); }
        }

        .slide-header {
            border-bottom: 2px solid var(--border-color);
            padding-bottom: 15px;
            margin-bottom: 20px;
        }

        .slide-header h2 {
            font-size: 1.8rem;
            color: var(--accent-blue);
        }

        .slide-header p {
            font-size: 0.95rem;
            color: var(--text-muted);
            margin-top: 5px;
        }

        .slide-body {
            flex-grow: 1;
            display: flex;
            flex-direction: column;
            justify-content: flex-start;
            gap: 15px;
            overflow-y: auto;
        }

        ul.content-list {
            list-style: none;
            display: flex;
            flex-direction: column;
            gap: 12px;
        }

        ul.content-list li {
            position: relative;
            padding-left: 25px;
            font-size: 1.05rem;
            line-height: 1.5;
        }

        ul.content-list li::before {
            content: "▹";
            position: absolute;
            left: 0;
            color: var(--accent-green);
            font-weight: bold;
            font-size: 1.2rem;
        }

        .highlight {
            color: var(--accent-purple);
            font-weight: 600;
        }

        .grid-2 {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 20px;
        }

        .card {
            background-color: var(--bg-color);
            border: 1px solid var(--border-color);
            padding: 15px;
            border-radius: 8px;
        }

        .card h3 {
            color: var(--accent-orange);
            font-size: 1.1rem;
            margin-bottom: 8px;
        }

        .team-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 15px;
            margin-top: 15px;
        }

        .team-member {
            background-color: var(--bg-color);
            border: 1px solid var(--border-color);
            padding: 12px;
            border-radius: 6px;
            text-align: center;
            font-weight: 600;
            color: var(--accent-blue);
        }

        .footer {
            margin-top: 20px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-top: 1px solid var(--border-color);
            padding-top: 15px;
            font-size: 0.85rem;
            color: var(--text-muted);
        }

        .controls {
            display: flex;
            gap: 10px;
        }

        button {
            background-color: var(--border-color);
            color: var(--text-main);
            border: none;
            padding: 8px 16px;
            border-radius: 6px;
            cursor: pointer;
            font-weight: 600;
            transition: background 0.2s;
        }

        button:hover {
            background-color: var(--accent-blue);
            color: #fff;
        }

        .title-slide {
            justify-content: center;
            align-items: center;
            text-align: center;
        }

        .title-slide h1 {
            font-size: 2.3rem;
            color: var(--accent-blue);
            margin-bottom: 10px;
        }

        .title-slide h3 {
            font-size: 1.3rem;
            color: var(--accent-green);
            margin-bottom: 25px;
        }

