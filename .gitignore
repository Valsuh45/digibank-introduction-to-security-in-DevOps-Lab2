# Git ignore rules for the DigiBank repository.
#
# These entries keep compiled classes, packaged archives, Maven target directories, IDE metadata, and JVM
# crash logs out of version control. That keeps pull requests focused on source code and helps prevent
# local machine files from leaking into the repository.
#
# Compiled class file
*.class

# Log file
*.log

# BlueJ files
*.ctxt

# Mobile Tools for Java (J2ME)
.mtj.tmp/

# Package Files #
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# virtual machine crash logs, see http://www.java.com/en/download/help/error_hotspot.xml
hs_err_pid*
replay_pid*

# Maven target directory
target/
**/target/

# Generated DAST reports (Postman/Newman and ZAP outputs)
dast/reports/

# IDE files
.idea/
*.iml
.classpath
.project
.settings/
.vscode/
.factorypath

# Local environment credentials (examples must contain placeholders only)
.env
.env.*
!.env.example
!.env.*.example

# Python verification helper bytecode
__pycache__/
*.py[cod]

# Reproducible container evidence is generated locally and uploaded in CI.
/container-security/reports/*
!/container-security/reports/.gitkeep
/dependency-tree.txt
/docker-image-inspect.json
/docker-image-history.txt
