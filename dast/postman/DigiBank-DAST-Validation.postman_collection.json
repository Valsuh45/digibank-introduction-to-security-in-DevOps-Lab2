                  "    pm.expect(text).to.not.include('swagger');",
                  "    pm.expect(text).to.not.include('openapi');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api-docs",
              "host": ["{{baseUrl}}"],
              "path": ["api-docs"]
            }
          }
        }
      ]
