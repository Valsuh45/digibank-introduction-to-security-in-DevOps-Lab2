            "body": {
              "mode": "raw",
              "raw": "{\n    \"sourceAccountNumber\": \"{{sourceAccountNumber}}\",\n    \"targetAccountNumber\": \"{{targetAccountNumber}}\",\n    \"amount\": 2500.00,\n    \"description\": \"DAST functional regression transfer\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/transfers",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "transfers"]
            }
          }
        },
        {
          "name": "Get transfer by id",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('HTTP status is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "const body = pm.response.json();",
                  "pm.test('Returned transfer id matches created transfer', function () {",
                  "    pm.expect(String(body.data.id)).to.eql(String(pm.collectionVariables.get('transferId')));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/transfers/{{transferId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "transfers", "{{transferId}}"]
            }
          }
        },
        {
          "name": "Get account transaction history",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('HTTP status is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "const body = pm.response.json();",
                  "pm.test('Transaction history is an array', function () {",
                  "    pm.expect(body.data).to.be.an('array');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/transfers/account/{{sourceAccountNumber}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "transfers", "account", "{{sourceAccountNumber}}"]
            }
          }
        }
      ]
    },
    {
      "name": "02-input-validation-check",
      "item": [
        {
          "name": "Create customer - invalid email rejected",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('HTTP status is 400', function () {",
                  "    pm.response.to.have.status(400);",
                  "});",
                  "pm.test('Response is a controlled validation error', function () {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.success).to.eql(false);",
                  "    pm.expect(body.message).to.eql('Validation failed');",
                  "});",
                  "pm.test('No technical trace is disclosed', function () {",
                  "    const text = pm.response.text().toLowerCase();",
                  "    pm.expect(text).to.not.include('exception');",
                  "    pm.expect(text).to.not.include('stacktrace');",
                  "    pm.expect(text).to.not.include('org.springframework');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"firstName\": \"Invalid\",\n    \"lastName\": \"Client\",\n    \"email\": \"invalid email\",\n    \"identityNumber\": \"DB-CUST-9003\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/customers",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "customers"]
            }
          }
        },
