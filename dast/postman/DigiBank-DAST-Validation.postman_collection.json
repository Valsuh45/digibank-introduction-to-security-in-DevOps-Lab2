              "mode": "raw",
              "raw": "{\n    \"firstName\": \"\",\n    \"lastName\": \"Client\",\n    \"email\": \"blank.name@digibank.test\",\n    \"identityNumber\": \"DB-CUST-9004\"\n}"
            },
            "url": {
