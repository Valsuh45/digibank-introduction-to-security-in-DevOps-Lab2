        {
          "name": "Execute transfer - valid",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('HTTP status is 201', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "const body = pm.response.json();",
                  "pm.test('Transfer response has an id', function () {",
                  "    pm.expect(body.data).to.have.property('id');",
                  "});",
                  "if (body && body.data && body.data.id) {",
                  "    pm.collectionVariables.set('transferId', body.data.id);",
