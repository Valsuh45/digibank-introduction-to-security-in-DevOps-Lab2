{
  "info": {
    "name": "DigiBank-DAST-Validation",
    "description": "Final DAST validation collection for DigiBank (Workshop 3). It replays functional regression, input-validation, error-handling, information-exposure, and remediation checks against a running DigiBank instance. All URLs use the {{baseUrl}} environment variable so the same collection runs locally and in CI with Newman.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "01-functional-regression-check",
      "item": [
        {
          "name": "Create customer - valid payload",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('HTTP status is 201', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "const body = pm.response.json();",
                  "pm.test('Response has an id and does not expose identityNumber', function () {",
                  "    pm.expect(body.data).to.have.property('id');",
                  "    pm.expect(body.data).to.not.have.property('identityNumber');",
                  "});",
                  "if (body && body.data && body.data.id) {",
                  "    pm.collectionVariables.set('customerId', body.data.id);",
                  "    pm.environment.set('customerId', body.data.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"firstName\": \"Jean\",\n    \"lastName\": \"Testeur\",\n    \"email\": \"jean.testeur@digibank.test\",\n    \"identityNumber\": \"DB-CUST-9001\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/customers",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "customers"]
            }
          }
        },
        {
          "name": "Create customer 2 - valid payload",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('HTTP status is 201', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "const body = pm.response.json();",
                  "if (body && body.data && body.data.id) {",
                  "    pm.collectionVariables.set('customer2Id', body.data.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"firstName\": \"Claire\",\n    \"lastName\": \"Benef\",\n    \"email\": \"claire.benef@digibank.test\",\n    \"identityNumber\": \"DB-CUST-9002\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/customers",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "customers"]
            }
          }
        },
        {
          "name": "List customers",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('HTTP status is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "const body = pm.response.json();",
                  "pm.test('Customer list is returned without identityNumber', function () {",
                  "    pm.expect(body.data).to.be.an('array');",
                  "    if (body.data.length > 0) {",
                  "        pm.expect(body.data[0]).to.not.have.property('identityNumber');",
                  "    }",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/customers",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "customers"]
            }
          }
        },
