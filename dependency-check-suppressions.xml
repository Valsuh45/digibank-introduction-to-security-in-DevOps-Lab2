        <notes>Retained upstream temporary risk acceptance; see docs/evidence/WORKSHOP_2_SAST.md.
            Revalidate against a current scan before accepting a release. This selects only this Maven version.</notes>
        <gav regex="true">^org\.springframework:spring-[^:]+:6\.2\.19$</gav>
        <cve>CVE-2026-47883</cve>
    </suppress>
