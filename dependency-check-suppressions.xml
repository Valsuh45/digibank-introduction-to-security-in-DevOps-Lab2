  justification. Do not add broad suppressions to hide real findings.
-->
<suppressions xmlns="https://jeremylong.github.io/DependencyCheck/dependency-suppression.1.3.xsd">
    <!-- Known Spring Framework 6.2.19 CVE; scoped to spring-framework package.
         Expires 2026-12-31; remove when patches are available. -->
